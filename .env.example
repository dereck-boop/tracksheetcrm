# Copy to .env for running on your own computer. On Vercel, set these under
# Settings → Environment Variables instead (see README.md).

# Postgres connection string. On Vercel + Neon this (and DATABASE_URL_UNPOOLED, used for
# migrations) is set for you when you connect the database.
DATABASE_URL="postgresql://user:password@localhost:5432/tracksheet"

# Long random string (32+ characters) used to sign logins. Never change it once you're live.
AUTH_SECRET=""
# Any word or phrase you choose. You type it once on the first-run setup page, so a stranger
# can't claim your new site before you do.
SETUP_CODE=""
# Your studio's timezone (IANA name), e.g. America/New_York, America/Chicago, America/Los_Angeles, Europe/London
STUDIO_TIMEZONE="America/New_York"
# Protects the daily reminders job (/api/cron/daily). Any long random string.
CRON_SECRET=""

# Your site's address. Optional on Vercel (it uses the project's production address);
# set it if you add your own domain, e.g. https://crm.yourstudio.com
APP_URL="http://localhost:3000"

# Card payments (Stripe), optional
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Client emails (Resend), optional but recommended. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Your Studio <studio@yourdomain.com>"

# Where to email an alert when something fails on the live site (defaults to the studio email)
ALERT_EMAIL=""
# Cloudflare Turnstile, a free invisible spam check on the booking page (optional)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
